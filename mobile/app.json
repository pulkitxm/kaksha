{
  "expo": {
    "name": "Kaksha",
    "slug": "kaksha",
    "version": "1.2.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "scheme": "kaksha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf3e3"
    },
    "android": {
      "package": "space.kaksha.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf3e3"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.kaksha.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-status-bar",
      "./plugins/with-landscape-lock.js",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://kaksha.pulkit.page"
    }
  }
}
