{
  "expo": {
    "name": "Kaksha",
    "slug": "kaksha",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "kaksha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf3e3"
    },
    "android": {
      "package": "space.kaksha.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf3e3"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.kaksha.app"
    },
    "plugins": ["expo-router", "expo-sharing", "expo-status-bar"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://kaksha-ppulkitxm.vercel.app"
    }
  }
}
