{
  "name": "@kaksha/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "bunx expo start",
    "android": "bunx expo start --android",
    "typecheck": "bunx tsc --noEmit",
    "prebuild": "bunx expo prebuild --platform android --clean",
    "bundle:android": "bunx expo export --platform android --output-dir .expo/export",
    "apk": "bunx eas-cli build --platform android --profile preview",
    "apk:local": "bun run scripts/build-apk.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@kaksha/core": "file:../core",
    "expo": "~57.0.9",
    "expo-asset": "^57.0.8",
    "expo-constants": "~57.0.8",
    "expo-file-system": "~18.0.12",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "^57.0.2",
    "react": "18.3.1",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-view-shot": "~4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3"
  }
}
