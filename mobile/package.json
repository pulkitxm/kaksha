{
  "name": "@kaksha/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "bunx expo start",
    "android": "bunx expo start --android",
    "typecheck": "bunx tsc --noEmit",
    "prebuild": "bunx expo prebuild --platform android --clean",
    "web": "bunx expo start --web",
    "bundle:android": "bunx expo export --platform android --output-dir .expo/export",
    "bundle:web": "bunx expo export --platform web --output-dir ../public",
    "apk": "bunx eas-cli build --platform android --profile preview",
    "apk:local": "bun run scripts/build-apk.mjs"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@babel/runtime": "^8.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@kaksha/core": "file:../core",
    "expo": "~57.0.9",
    "expo-asset": "^57.0.8",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
