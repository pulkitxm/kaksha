{
  "name": "kaksha",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "core",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @kaksha/core && npm run build -w @kaksha/server",
    "dev:server": "npm run dev -w @kaksha/server",
    "typecheck": "npm run typecheck -w @kaksha/core && npm run typecheck -w @kaksha/server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:comments": "node scripts/check-comments.mjs",
    "dead-code": "knip",
    "db:generate": "npm run db:generate -w @kaksha/server",
    "db:migrate": "npm run db:migrate -w @kaksha/server",
    "db:seed": "npm run db:seed -w @kaksha/server",
    "db:studio": "npm run db:studio -w @kaksha/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "knip": "^5.44.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  },
  "dependencies": {
    "@kaksha/server": "*"
  }
}
