{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "core": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "server": {
      "entry": ["api/index.ts"],
      "project": ["src/**/*.ts", "api/**/*.ts", "scripts/**/*.ts"]
    }
  },
  "ignoreDependencies": []
}
