{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "api/index.ts"],
      "project": ["scripts/**/*.mjs", "api/**/*.ts"]
    },
    "core": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "server": {
      "entry": ["src/index.ts", "src/server.ts", "scripts/seed.ts", "drizzle.config.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    }
  },
  "ignoreDependencies": [],
  "ignore": ["mobile/**"]
}
